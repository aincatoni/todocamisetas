          "name": "02.01 Listar clientes",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "const clientes = json.data || [];",
                  "const preferencial = clientes.find(c => c.nombre_comercial === '90minutos');",
                  "const regular = clientes.find(c => c.nombre_comercial === 'tdeportes');",
                  "if (preferencial) pm.collectionVariables.set('clientePreferencialId', String(preferencial.id));",
                  "if (regular) pm.collectionVariables.set('clienteRegularId', String(regular.id));"
                ],
                "type": "text/javascript"
              }
